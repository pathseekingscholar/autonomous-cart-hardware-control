[Unit]
Description=Autonomous Shopping Cart Pi Agent
After=network-online.target pigpiod.service
Wants=network-online.target

[Service]
Type=simple
User=__PI_USER__
WorkingDirectory=__APP_DIR__
ExecStart=/bin/bash __APP_DIR__/scripts/pi_run_agent.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
